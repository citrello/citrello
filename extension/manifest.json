{
  "manifest_version": 3,
  "name": "Citrello",
  "short_name": "Citrello",
  "version": "1.0.0",
  "description": "Add papers to your Citrello library with one click, and give ChatGPT and Claude the full text of the papers you have access to.",
  "homepage_url": "https://citrello.app",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Add to Citrello",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://citrello.app/*",
        "http://localhost:8585/*",
        "http://127.0.0.1:8585/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Add this paper to Citrello"
    }
  },
  "host_permissions": [
    "http://localhost:8585/*",
    "http://127.0.0.1:8585/*"
  ]
}
